\label{fig:experiment_schematic}
\end{figure}

\subsection{Mathematical Model}

The DC motor with variable load is modeled as:
\begin{equation}
J\dot{\omega} + b\omega = K_t i
\label{eq:motor_dynamics}
\end{equation}
where:
\begin{itemize}
    \item $\omega$: angular velocity (rad/s)
    \item $J$: total moment of inertia (motor + load)
    \item $b$: viscous friction coefficient
    \item $K_t$: motor torque constant
    \item $i$: armature current
\end{itemize}

When mass is added to the disc at radius $r$, the inertia changes:
\begin{equation}
J_{total} = J_{motor} + m_{load} r^2
\label{eq:inertia_change}
\end{equation}

With electrical dynamics much faster than mechanical, the transfer function is approximately:
\begin{equation}
G(s) = \frac{\omega(s)}{V(s)} = \frac{K}{Js + b} = \frac{K/b}{\tau s + 1}
\label{eq:motor_tf}
\end{equation}
where $\tau = J/b$ changes with load.

\subsection{Controller Implementation}

\subsubsection{Fixed PI Controller}

The baseline fixed controller is a PI controller tuned for the unloaded motor:
\begin{equation}
u(t) = K_p e(t) + K_i \int_0^t e(\tau) d\tau
\label{eq:pi_controller}
\end{equation}

\subsubsection{Adaptive Controller (MIT Rule)}

The adaptive controller uses the same PI structure but adjusts gains online:
\begin{align}
\dot{\hat{K}}_p &= \gamma_p e \cdot e \label{eq:adapt_kp}\\
\dot{\hat{K}}_i &= \gamma_i e \cdot \int e \, dt \label{eq:adapt_ki}
\end{align}

\subsection{Arduino Implementation}

\begin{lstlisting}[style=arduinoStyle, caption={Adaptive motor control Arduino code}]
// Adaptive Motor Speed Control
// Demonstrates MIT Rule adaptation with variable load

// Pin definitions
const int PWM_PIN = 9;
const int DIR_PIN = 8;
const int ENCODER_A = 2;
const int ENCODER_B = 3;

// Controller parameters
float Kp = 2.0;           // Initial proportional gain
float Ki = 0.5;           // Initial integral gain
float gamma_p = 0.001;    // Adaptation rate for Kp
float gamma_i = 0.0005;   // Adaptation rate for Ki

// Reference model (first-order, tau = 0.2s)
float tau_m = 0.2;
float omega_m = 0.0;

// State variables
volatile long encoderCount = 0;
float omega = 0.0;        // Measured speed
float omega_ref = 100.0;  // Reference speed (rad/s)
float integral = 0.0;
float error = 0.0;
float tracking_error = 0.0;

// Timing
unsigned long lastTime = 0;
const float dt = 0.01;    // 10ms sample time

void setup() {
    pinMode(PWM_PIN, OUTPUT);
    pinMode(DIR_PIN, OUTPUT);
    pinMode(ENCODER_A, INPUT_PULLUP);
    pinMode(ENCODER_B, INPUT_PULLUP);

    attachInterrupt(digitalPinToInterrupt(ENCODER_A),
                    encoderISR, RISING);

    Serial.begin(115200);
    Serial.println("Time,Omega_ref,Omega_m,Omega,Kp,Ki,Error");
}

void loop() {
    unsigned long currentTime = millis();

    if (currentTime - lastTime >= (unsigned long)(dt * 1000)) {
        // Calculate speed from encoder
        noInterrupts();
        long count = encoderCount;
        encoderCount = 0;
        interrupts();

        omega = (count * 2.0 * PI) / (1440.0 * dt);  // 1440 CPR

        // Update reference model
        omega_m += dt * (-omega_m / tau_m + omega_ref / tau_m);

        // Calculate errors
        error = omega_ref - omega;           // For PI controller
        tracking_error = omega - omega_m;    // For adaptation

        // Integral term with anti-windup
        integral += error * dt;
        integral = constrain(integral, -50, 50);

        // Adaptive PI control
        float u = Kp * error + Ki * integral;

        // MIT Rule adaptation
        Kp += gamma_p * tracking_error * error * dt;
        Ki += gamma_i * tracking_error * integral * dt;

        // Constrain gains to reasonable values
        Kp = constrain(Kp, 0.5, 10.0);
        Ki = constrain(Ki, 0.1, 5.0);

        // Apply control
        int pwm = constrain(abs(u), 0, 255);
        digitalWrite(DIR_PIN, u >= 0 ? HIGH : LOW);
        analogWrite(PWM_PIN, pwm);

        // Log data
        Serial.print(currentTime);
        Serial.print(",");
        Serial.print(omega_ref);
        Serial.print(",");
        Serial.print(omega_m);
        Serial.print(",");
        Serial.print(omega);
        Serial.print(",");
        Serial.print(Kp);
        Serial.print(",");
        Serial.print(Ki);
        Serial.print(",");
        Serial.println(tracking_error);

        lastTime = currentTime;
    }
}

void encoderISR() {
    if (digitalRead(ENCODER_B) == LOW) {
        encoderCount++;
    } else {
        encoderCount--;
    }
}
\end{lstlisting}

\subsection{Experimental Procedure}

\begin{enumerate}
    \item \textbf{Baseline Characterization:}
    \begin{enumerate}
        \item Run motor with no load, record step response
        \item Identify time constant $\tau_0$ and gain $K_0$
        \item Tune fixed PI controller for good performance
    \end{enumerate}

    \item \textbf{Fixed Controller Under Load Variation:}
    \begin{enumerate}
        \item Set reference speed to 100 rad/s
        \item Wait for steady state
        \item Add 50g weight at 5cm radius
        \item Record response degradation
        \item Add 100g total weight
        \item Document further degradation
    \end{enumerate}

    \item \textbf{Adaptive Controller Under Load Variation:}
    \begin{enumerate}
        \item Reset to no load condition
        \item Enable adaptive control
        \item Repeat load variation sequence
        \item Record adaptation of gains
        \item Observe maintained performance
    \end{enumerate}

    \item \textbf{Comparative Analysis:}
    \begin{enumerate}
        \item Plot fixed vs. adaptive responses
        \item Calculate performance metrics (rise time, overshoot, settling time)
        \item Show gain adaptation history
    \end{enumerate}
\end{enumerate}

\subsection{Expected Results}

