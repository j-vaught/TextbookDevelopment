        \item \AA str\"om, K.J. and Wittenmark, B., \textit{Adaptive Control}, 2nd ed., Addison-Wesley, 1995
        \item Narendra, K.S. and Annaswamy, A.M., \textit{Stable Adaptive Systems}, Prentice Hall, 1989
        \item Ioannou, P.A. and Sun, J., \textit{Robust Adaptive Control}, Prentice Hall, 1996
    \end{itemize}

    \item \textbf{Historical papers:}
    \begin{itemize}
        \item Whitaker, H.P., Yamron, J., and Kezer, A., ``Design of Model Reference Adaptive Control Systems for Aircraft,'' MIT Instrumentation Laboratory Report R-164, 1958
        \item Rohrs, C.E., Valavani, L., Athans, M., and Stein, G., ``Robustness of Continuous-Time Adaptive Control Algorithms in the Presence of Unmodeled Dynamics,'' IEEE Trans. Automatic Control, 1985
    \end{itemize}

    \item \textbf{Modern developments:}
