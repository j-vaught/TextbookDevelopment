\node[block, fill=gray!20, right=2cm of nn] (plant) {Plant\\$\mathbf{x}[k+1] = g(\mathbf{x}[k], \mathbf{u}[k])$};
\node[right=1.5cm of plant] (output) {$\mathbf{y}$};

