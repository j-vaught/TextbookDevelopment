\subsection{Phase 3: Export and Deployment}

\subsubsection{Convert to C Code}

For deployment on Arduino, convert the trained weights to C arrays:

\begin{lstlisting}[language=Python, caption={Export weights for Arduino deployment}]
def export_weights_to_c(model, filename='nn_weights.h'):
    with open(filename, 'w') as f:
        f.write("// Auto-generated neural network weights\n\n")

        layer_idx = 0
        for name, param in model.named_parameters():
            data = param.detach().numpy().flatten()
            f.write(f"const float {name.replace('.', '_')}[] = {{\n  ")
            f.write(", ".join(f"{x:.6f}" for x in data))
            f.write("\n};\n\n")

        # Also export normalization constants
        f.write(f"const float control_mean = {control_mean:.6f};\n")
        f.write(f"const float control_std = {control_std:.6f};\n")

export_weights_to_c(model)
\end{lstlisting}

\subsubsection{Arduino Neural Network Implementation}

\begin{lstlisting}[language=C, caption={Neural network inference on Arduino}]
#include "nn_weights.h"

#define INPUT_DIM 3
#define HIDDEN_DIM 32

float hidden1[HIDDEN_DIM];
float hidden2[HIDDEN_DIM];

float relu(float x) {
    return x > 0 ? x : 0;
}

float neuralNetworkControl(float error, float velocity, float error_int) {
    // Normalize inputs (using training statistics)
    float input[INPUT_DIM] = {
        (error - error_mean) / error_std,
        (velocity - velocity_mean) / velocity_std,
        (error_int - error_int_mean) / error_int_std
    };

    // Layer 1: input -> hidden1
    for (int i = 0; i < HIDDEN_DIM; i++) {
        hidden1[i] = network_0_bias[i];
        for (int j = 0; j < INPUT_DIM; j++) {
            hidden1[i] += network_0_weight[i * INPUT_DIM + j] * input[j];
        }
        hidden1[i] = relu(hidden1[i]);
    }

    // Layer 2: hidden1 -> hidden2
    for (int i = 0; i < HIDDEN_DIM; i++) {
        hidden2[i] = network_2_bias[i];
        for (int j = 0; j < HIDDEN_DIM; j++) {
            hidden2[i] += network_2_weight[i * HIDDEN_DIM + j] * hidden1[j];
        }
        hidden2[i] = relu(hidden2[i]);
    }

    // Layer 3: hidden2 -> output
    float output = network_4_bias[0];
    for (int j = 0; j < HIDDEN_DIM; j++) {
        output += network_4_weight[j] * hidden2[j];
    }

    // Denormalize output
    output = output * control_std + control_mean;
    return constrain(output, -255, 255);
}
\end{lstlisting}

