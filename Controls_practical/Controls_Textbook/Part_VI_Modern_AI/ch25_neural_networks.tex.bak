\subsection{Phase 1: PID Controller and Data Collection}

\subsubsection{PID Implementation}

First, implement a well-tuned PID controller on the Arduino:

\begin{lstlisting}[language=C, caption={Arduino PID controller for data collection}]
// PID constants (tune for your motor)
float Kp = 2.0;
float Ki = 0.5;
float Kd = 0.1;

// State variables
float integral = 0;
float prev_error = 0;
unsigned long prev_time = 0;

float computePID(float setpoint, float position) {
    unsigned long now = millis();
    float dt = (now - prev_time) / 1000.0;
    prev_time = now;

    float error = setpoint - position;
    integral += error * dt;
    integral = constrain(integral, -100, 100); // Anti-windup

    float derivative = (error - prev_error) / dt;
    prev_error = error;

    float output = Kp * error + Ki * integral + Kd * derivative;
    return constrain(output, -255, 255);
}

void loop() {
    // Read encoder position
    float position = readEncoder();

    // Get setpoint (e.g., from serial or internal reference)
    float setpoint = generateSetpoint();

    // Compute control
    float control = computePID(setpoint, position);

    // Apply to motor
    setMotorPWM(control);

    // Log data for training
    Serial.print(millis());
    Serial.print(",");
    Serial.print(setpoint);
    Serial.print(",");
    Serial.print(position);
    Serial.print(",");
    Serial.print(control);
    Serial.print(",");
    Serial.println(prev_error);
}
\end{lstlisting}

\subsubsection{Reference Signal Design}

To collect diverse training data, use varied reference signals:
\begin{itemize}
\item Step inputs of different magnitudes
\item Sinusoidal references at different frequencies
\item Random walk sequences
\item Ramp inputs
\end{itemize}

\begin{lstlisting}[language=C, caption={Reference signal generator}]
float generateSetpoint() {
    static unsigned long last_change = 0;
    static float setpoint = 0;
    static int mode = 0;

    unsigned long now = millis();
    float t = now / 1000.0;

    switch (mode) {
        case 0: // Step inputs
            if (now - last_change > 3000) {
                setpoint = random(-180, 180);
                last_change = now;
            }
            break;
        case 1: // Sinusoidal
            setpoint = 90 * sin(2 * PI * 0.2 * t);
            break;
        case 2: // Ramp
            setpoint = 30 * t;
            if (setpoint > 180) setpoint = -180;
            break;
    }
    return setpoint;
}
\end{lstlisting}

\subsubsection{Data Collection Protocol}

Run the PID controller for approximately 10 minutes, collecting data at 50 Hz (20 ms intervals). This yields approximately 30,000 data points. Save the data as CSV:
\begin{verbatim}
time_ms, setpoint, position, control, error
0, 45.0, 0.0, 90.0, 45.0
20, 45.0, 2.3, 87.5, 42.7
40, 45.0, 5.1, 83.2, 39.9
...
\end{verbatim}

\subsection{Phase 2: Neural Network Training}

\subsubsection{Data Preprocessing}

\begin{lstlisting}[language=Python, caption={Python code for data loading and preprocessing}]
import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, TensorDataset

# Load data
data = np.loadtxt('motor_data.csv', delimiter=',', skiprows=1)
time_ms = data[:, 0]
setpoint = data[:, 1]
position = data[:, 2]
control = data[:, 3]

# Compute features
error = setpoint - position

# Compute velocity (finite difference)
velocity = np.gradient(position, time_ms / 1000.0)

# Compute integral of error (cumulative sum)
dt = np.diff(time_ms, prepend=time_ms[0]) / 1000.0
error_integral = np.cumsum(error * dt)

# Normalize features
def normalize(x):
    return (x - x.mean()) / (x.std() + 1e-8)

X = np.column_stack([
    normalize(error),
    normalize(velocity),
    normalize(error_integral)
])

# Normalize targets
control_mean = control.mean()
control_std = control.std()
y = (control - control_mean) / control_std

# Convert to PyTorch tensors
X_tensor = torch.FloatTensor(X)
y_tensor = torch.FloatTensor(y).unsqueeze(1)

# Split train/validation
split = int(0.8 * len(X))
train_dataset = TensorDataset(X_tensor[:split], y_tensor[:split])
val_dataset = TensorDataset(X_tensor[split:], y_tensor[split:])

train_loader = DataLoader(train_dataset, batch_size=64, shuffle=True)
val_loader = DataLoader(val_dataset, batch_size=64)
\end{lstlisting}

\subsubsection{Network Architecture}

\begin{lstlisting}[language=Python, caption={Neural network architecture for motor control}]
class MotorController(nn.Module):
    def __init__(self, input_dim=3, hidden_dim=32):
        super().__init__()
        self.network = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, 1)
        )

    def forward(self, x):
        return self.network(x)

model = MotorController(input_dim=3, hidden_dim=32)
print(f"Total parameters: {sum(p.numel() for p in model.parameters())}")
# Output: Total parameters: 1185
\end{lstlisting}

\subsubsection{Training Loop}

\begin{lstlisting}[language=Python, caption={Training the neural network controller}]
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
criterion = nn.MSELoss()

train_losses = []
val_losses = []

for epoch in range(100):
    # Training
    model.train()
    train_loss = 0
    for X_batch, y_batch in train_loader:
        optimizer.zero_grad()
        pred = model(X_batch)
        loss = criterion(pred, y_batch)
        loss.backward()
        optimizer.step()
        train_loss += loss.item()
    train_loss /= len(train_loader)
    train_losses.append(train_loss)

    # Validation
    model.eval()
    val_loss = 0
    with torch.no_grad():
        for X_batch, y_batch in val_loader:
            pred = model(X_batch)
            val_loss += criterion(pred, y_batch).item()
    val_loss /= len(val_loader)
    val_losses.append(val_loss)

    if (epoch + 1) % 10 == 0:
        print(f"Epoch {epoch+1}: Train Loss = {train_loss:.4f}, "
              f"Val Loss = {val_loss:.4f}")

# Save model
torch.save(model.state_dict(), 'motor_controller.pth')
\end{lstlisting}

