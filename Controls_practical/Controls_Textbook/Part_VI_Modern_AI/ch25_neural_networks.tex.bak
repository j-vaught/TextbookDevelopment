\draw[arrow] (sum) -- (nn) node[midway, above] {$\mathbf{e}$};
\draw[arrow] (nn) -- (plant) node[midway, above] {$\mathbf{u}$};
\draw[arrow] (plant) -- (output);

% Feedback
\draw[arrow] (plant.east) -- ++(0.7,0) -- ++(0,-1.5) -| (sum.south);
\node at (sum) [below left=0.1cm, font=\small] {$-$};
\node at (sum) [above left=0.1cm, font=\small] {$+$};
\end{tikzpicture}
\caption{Neural network controller in a feedback loop. The network maps error $\mathbf{e}$ to control action $\mathbf{u}$.}
\label{fig:nn_control_loop}
\end{figure}

The architecture design involves choosing:
\begin{itemize}
\item \textbf{Inputs:} Current state $\mathbf{x}[k]$, error $\mathbf{e}[k]$, or history $\{\mathbf{x}[k], \mathbf{x}[k-1], \ldots\}$
\item \textbf{Outputs:} Control action $\mathbf{u}[k]$ (possibly with saturation limits)
\item \textbf{Hidden layers:} Number and size (empirically chosen or via hyperparameter search)
\item \textbf{Activation functions:} ReLU for hidden layers, linear or tanh for output
\end{itemize}

\subsection{Neural Network as Plant Model}

Neural networks can learn system dynamics for simulation or model-based control:
\begin{equation}
\hat{\mathbf{x}}[k+1] = f_{\theta}(\mathbf{x}[k], \mathbf{u}[k]).
\label{eq:nn_model}
\end{equation}

This is particularly valuable when:
\begin{itemize}
\item First-principles models are unavailable (e.g., complex biological systems)
\item Physics-based models are too computationally expensive
\item The system contains unmodeled nonlinearities or disturbances
\end{itemize}

The learned model can be used for:
\begin{enumerate}
\item \textbf{Simulation:} Predict system behavior under proposed control policies
\item \textbf{MPC:} Provide the prediction model for optimization
\item \textbf{Controller training:} Serve as a ``surrogate'' for the real plant during reinforcement learning
\end{enumerate}

