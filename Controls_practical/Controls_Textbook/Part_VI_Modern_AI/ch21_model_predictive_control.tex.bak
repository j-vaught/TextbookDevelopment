\subsection{Software Implementation}

\subsubsection{PID Controller with Anti-Windup}

\begin{lstlisting}[caption={PID Controller Implementation}, label={lst:pid_tank}]
// PID Controller with basic anti-windup
class PIDController {
  float Kp, Ki, Kd;
  float integral, prevError;
  float outputMin, outputMax;

public:
  PIDController(float kp, float ki, float kd,
                float outMin, float outMax) {
    Kp = kp; Ki = ki; Kd = kd;
    outputMin = outMin; outputMax = outMax;
    integral = 0; prevError = 0;
  }

  float compute(float setpoint, float measurement, float dt) {
    float error = setpoint - measurement;

    // Proportional term
    float P = Kp * error;

    // Integral term with anti-windup
    integral += Ki * error * dt;

    // Derivative term
    float derivative = (error - prevError) / dt;
    float D = Kd * derivative;

    // Compute output
    float output = P + integral + D;

    // Anti-windup: clamp integral if output saturates
    if (output > outputMax) {
      integral -= (output - outputMax);
      output = outputMax;
    } else if (output < outputMin) {
      integral -= (output - outputMin);
      output = outputMin;
    }

    prevError = error;
    return output;
  }

  void reset() {
    integral = 0;
    prevError = 0;
  }
};
\end{lstlisting}

\subsubsection{Simple MPC Implementation}

For this educational experiment, we implement a simplified MPC that solves the unconstrained problem analytically, then projects the solution onto the constraint set.

\begin{lstlisting}[caption={Simplified MPC Implementation}, label={lst:mpc_tank}]
// Simplified MPC for two-tank system
// Uses explicit solution for small horizon

class SimpleMPC {
  // Model parameters (discrete-time)
  float A[2][2], B[2];  // State-space matrices
  float Q[2], R;        // Cost weights
  int N;                // Horizon length
  float uMin, uMax;     // Input constraints

  // Precomputed matrices for horizon N=3
  float H, f_coeff[2];  // QP parameters

public:
  SimpleMPC(float a11, float a12, float a21, float a22,
            float b1, float b2, float q1, float q2,
            float r, float umin, float umax) {
    A[0][0] = a11; A[0][1] = a12;
    A[1][0] = a21; A[1][1] = a22;
    B[0] = b1; B[1] = b2;
    Q[0] = q1; Q[1] = q2;
    R = r;
    uMin = umin; uMax = umax;
    N = 3;  // Fixed horizon for simplicity

    // Precompute H matrix for N=3 horizon
    // H = B'*Q_bar*B + R_bar (simplified scalar version)
    computeQPMatrices();
  }

  void computeQPMatrices() {
    // For educational purposes, using simplified computation
    // Full implementation would build the matrices from Sec III
    H = 3*R + (Q[0]*B[0]*B[0] + Q[1]*B[1]*B[1]) *
        (1 + A[0][0]*A[0][0] + A[0][0]*A[0][0]*A[0][0]*A[0][0]);

    f_coeff[0] = 2*(Q[0]*B[0]*A[0][0] + Q[1]*B[1]*A[1][0]);
    f_coeff[1] = 2*(Q[0]*B[0]*A[0][1] + Q[1]*B[1]*A[1][1]);
  }

  float compute(float x1, float x2) {
    // Compute linear cost term f = B'*Q_bar*A_bar*x
    float f = f_coeff[0]*x1 + f_coeff[1]*x2;

    // Unconstrained optimum: u* = -H^{-1} * f
    float u_opt = -f / H;

    // Project onto constraints [uMin, uMax]
    if (u_opt < uMin) u_opt = uMin;
    if (u_opt > uMax) u_opt = uMax;

    return u_opt;
  }
};

// Main control loop
SimpleMPC mpc(/* parameters */);
PIDController pid(2.0, 0.5, 0.1, 0, 255);

void loop() {
  // Read sensor values
  float h1 = readLevel(SENSOR1_PIN);
  float h2 = readLevel(SENSOR2_PIN);

  // Compute control based on mode
  float u;
  if (useMPC) {
    // MPC: uses state (deviation from setpoint)
    float x1 = h1 - setpoint1;
    float x2 = h2 - setpoint2;
    u = mpc.compute(x1, x2);
  } else {
    // PID: single-loop on tank 2 level
    u = pid.compute(setpoint2, h2, dt);
  }

  // Apply control
  analogWrite(PUMP_PIN, (int)u);

  // Log data for analysis
  logData(h1, h2, u, setpoint2);

  delay(SAMPLE_TIME_MS);
}
\end{lstlisting}

\subsection{Experimental Procedure}

\subsubsection{Part 1: System Identification}

\begin{enumerate}
    \item Fill reservoir and establish steady-state at mid-level
    \item Apply step changes in pump PWM (e.g., 100 to 150)
    \item Record tank levels over time
    \item Fit first-order-plus-delay models to responses
    \item Extract time constants $T_1$, $T_2$ and gains
\end{enumerate}

\subsubsection{Part 2: PID Control Experiment}

\begin{enumerate}
    \item Tune PID controller for acceptable step response at nominal operating point
    \item Command a large positive setpoint change (level increase)
    \item Observe: pump saturates at maximum, but recovers reasonably
    \item Command a large negative setpoint change (level decrease)
    \item Observe: pump saturates at zero (cannot go negative), integrator winds up
    \item Record overshoot, settling time, and constraint violations
\end{enumerate}

\subsubsection{Part 3: MPC Control Experiment}

\begin{enumerate}
    \item Configure MPC with same target response speed as PID
    \item Repeat the large positive setpoint change
    \item Observe: MPC may preemptively limit pump rate to avoid later saturation
    \item Repeat the large negative setpoint change
    \item Observe: MPC reduces pump to minimum (not negative), plans descent trajectory
    \item Compare performance metrics to PID
\end{enumerate}

