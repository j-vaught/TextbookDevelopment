    \fill[blue!20] (0,0) circle (2);
    \node at (0,0) {LQR = MPC};
    \node[below] at (0,-2.3) {(no constraints active)};

    % Constraint boundary
    \draw[thick, red] (-3.5,0) -- (3.5,0);
    \draw[thick, red] (0,-3) -- (0,3);
