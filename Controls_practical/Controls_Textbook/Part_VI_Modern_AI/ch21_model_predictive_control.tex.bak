\section*{Further Reading}
\addcontentsline{toc}{section}{Further Reading}
%==============================================================================

\begin{itemize}
    \item J. M. Maciejowski, \textit{Predictive Control with Constraints}, Prentice Hall, 2002. [Excellent introduction with practical emphasis]

    \item J. B. Rawlings and D. Q. Mayne, \textit{Model Predictive Control: Theory and Design}, Nob Hill Publishing, 2009. [Comprehensive theoretical treatment]

    \item C. E. Garcia, D. M. Prett, and M. Morari, ``Model Predictive Control: Theory and Practice---A Survey,'' \textit{Automatica}, vol. 25, no. 3, pp. 335--348, 1989. [Classic survey paper]

    \item S. J. Qin and T. A. Badgwell, ``A Survey of Industrial Model Predictive Control Technology,'' \textit{Control Engineering Practice}, vol. 11, no. 7, pp. 733--764, 2003. [Industrial applications overview]

    \item F. Borrelli, A. Bemporad, and M. Morari, \textit{Predictive Control for Linear and Hybrid Systems}, Cambridge University Press, 2017. [Modern treatment with hybrid systems]
\end{itemize}

