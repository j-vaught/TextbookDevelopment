\begin{table}[H]
\centering
\caption{Summary of Transient Specifications for Standard Second-Order Systems}
\label{tab:transient_summary}
\begin{tabular}{lcc}
\toprule
\textbf{Specification} & \textbf{Formula} & \textbf{Depends on} \\
\midrule
Rise time (10\%--90\%) & $t_r \approx \dfrac{1.8}{\omega_n}$ & $\omega_n$ \\[1.5ex]
Peak time & $t_p = \dfrac{\pi}{\omega_n\sqrt{1-\zeta^2}}$ & $\omega_n$, $\zeta$ \\[1.5ex]
Percent overshoot & $\text{PO} = 100 \cdot e^{-\pi\zeta/\sqrt{1-\zeta^2}}$ & $\zeta$ only \\[1.5ex]
Settling time (2\%) & $t_s \approx \dfrac{4}{\zeta\omega_n}$ & $\zeta\omega_n = \sigma$ \\[1.5ex]
\bottomrule
\end{tabular}
\end{table}

%=============================================================================
\section{Mathematical Foundation: Steady-State Error Analysis}
%=============================================================================

While transient specifications describe \textit{how} a system reaches its final value, steady-state error analysis addresses \textit{whether} it reaches the correct value at all.

%-----------------------------------------------------------------------------
\subsection{The Final Value Theorem}
%-----------------------------------------------------------------------------

The \textbf{Final Value Theorem} provides a powerful method for determining the steady-state value directly from the Laplace transform, without inverting to the time domain.

\begin{keyconceptbox}[Final Value Theorem]
If $y(t)$ and $dy/dt$ are Laplace transformable, and if $\lim_{t\to\infty} y(t)$ exists and is finite, then:
\begin{equation}
    \boxed{\lim_{t\to\infty} y(t) = \lim_{s\to 0} sY(s)}
    \label{eq:final_value_theorem}
\end{equation}
\end{keyconceptbox}

\textbf{Important caveat}: The final value theorem is only valid when the limit exists---that is, when all poles of $sY(s)$ have negative real parts except possibly for a simple pole at $s = 0$. If the system is unstable, or if there are poles on the imaginary axis (other than at the origin), the theorem gives incorrect results.

%-----------------------------------------------------------------------------
\subsection{Unity Feedback Configuration}
%-----------------------------------------------------------------------------

Consider the standard unity feedback configuration:

\begin{figure}[H]
\centering
\begin{tikzpicture}[
    block/.style={draw, rectangle, minimum height=1cm, minimum width=1.5cm},
    sum/.style={draw, circle, minimum size=0.6cm, inner sep=0pt},
    >=Stealth
]
% Blocks
\node[sum] (sum) at (0,0) {};
\node[block] (G) at (3,0) {$G(s)$};

% Labels
\node at (sum.north east) [anchor=south west, font=\scriptsize] {$+$};
\node at (sum.south east) [anchor=north west, font=\scriptsize] {$-$};

% Input
\draw[->] (-2,0) -- (sum) node[midway, above] {$R(s)$};

% Error
\draw[->] (sum) -- (G) node[midway, above] {$E(s)$};

% Output
\draw[->] (G) -- (5.5,0) node[midway, above] {};
\node at (5.8,0) {$Y(s)$};

% Feedback
\draw[->] (4.5,0) -- (4.5,-1.2) -- (0,-1.2) -- (sum);

\end{tikzpicture}
\caption{Unity feedback configuration for steady-state error analysis.}
\label{fig:unity_feedback}
\end{figure}

The error signal is:
\begin{equation}
    E(s) = R(s) - Y(s) = R(s) - G(s)E(s)
\end{equation}

Solving for $E(s)$:
\begin{equation}
    E(s) = \frac{R(s)}{1 + G(s)}
    \label{eq:error_transfer}
\end{equation}

The steady-state error for a given input is:
\begin{equation}
    e_{ss} = \lim_{t\to\infty} e(t) = \lim_{s\to 0} sE(s) = \lim_{s\to 0} \frac{sR(s)}{1 + G(s)}
    \label{eq:ess_general}
\end{equation}

%-----------------------------------------------------------------------------
\subsection{System Type and Error Constants}
%-----------------------------------------------------------------------------

The \textbf{system type} is defined as the number of pure integrators ($1/s$ factors) in the open-loop transfer function $G(s)$.

A general open-loop transfer function can be written as:
\begin{equation}
    G(s) = \frac{K(s+z_1)(s+z_2)\cdots}{s^N(s+p_1)(s+p_2)\cdots}
\end{equation}

where $N$ is the system type (number of integrators).

\begin{keyconceptbox}[System Type Classification]
\begin{itemize}
    \item \textbf{Type 0}: No integrators --- $G(s) = K(\cdots)/[(\cdots)]$
    \item \textbf{Type 1}: One integrator --- $G(s) = K(\cdots)/[s(\cdots)]$
    \item \textbf{Type 2}: Two integrators --- $G(s) = K(\cdots)/[s^2(\cdots)]$
\end{itemize}
\end{keyconceptbox}

We define three \textbf{error constants}:

\textbf{Position error constant} (for step inputs):
\begin{equation}
    \boxed{K_p = \lim_{s\to 0} G(s)}
    \label{eq:Kp}
\end{equation}

\textbf{Velocity error constant} (for ramp inputs):
\begin{equation}
    \boxed{K_v = \lim_{s\to 0} sG(s)}
    \label{eq:Kv}
\end{equation}

\textbf{Acceleration error constant} (for parabolic inputs):
\begin{equation}
    \boxed{K_a = \lim_{s\to 0} s^2G(s)}
    \label{eq:Ka}
\end{equation}

%-----------------------------------------------------------------------------
\subsection{Steady-State Error for Standard Inputs}
%-----------------------------------------------------------------------------

\subsubsection{Step Input: $R(s) = 1/s$}

\begin{equation}
    e_{ss} = \lim_{s\to 0} \frac{s \cdot (1/s)}{1 + G(s)} = \lim_{s\to 0} \frac{1}{1 + G(s)} = \frac{1}{1 + K_p}
    \label{eq:ess_step}
\end{equation}

\subsubsection{Ramp Input: $R(s) = 1/s^2$}

\begin{equation}
    e_{ss} = \lim_{s\to 0} \frac{s \cdot (1/s^2)}{1 + G(s)} = \lim_{s\to 0} \frac{1}{s + sG(s)} = \lim_{s\to 0} \frac{1}{sG(s)} = \frac{1}{K_v}
    \label{eq:ess_ramp}
\end{equation}

\subsubsection{Parabolic Input: $R(s) = 1/s^3$}

\begin{equation}
    e_{ss} = \lim_{s\to 0} \frac{s \cdot (1/s^3)}{1 + G(s)} = \lim_{s\to 0} \frac{1}{s^2G(s)} = \frac{1}{K_a}
    \label{eq:ess_parabola}
\end{equation}

%-----------------------------------------------------------------------------
\subsection{Steady-State Error Summary by System Type}
%-----------------------------------------------------------------------------

\begin{table}[H]
\centering
\caption{Steady-State Error as a Function of System Type}
\label{tab:ess_system_type}
\begin{tabular}{c|ccc|ccc}
\toprule
\textbf{System} & \multicolumn{3}{c|}{\textbf{Error Constants}} & \multicolumn{3}{c}{\textbf{Steady-State Error $e_{ss}$}} \\
\textbf{Type} & $K_p$ & $K_v$ & $K_a$ & Step & Ramp & Parabolic \\
\midrule
Type 0 & $K$ (finite) & 0 & 0 & $\dfrac{1}{1+K}$ & $\infty$ & $\infty$ \\[2ex]
Type 1 & $\infty$ & $K$ (finite) & 0 & 0 & $\dfrac{1}{K}$ & $\infty$ \\[2ex]
Type 2 & $\infty$ & $\infty$ & $K$ (finite) & 0 & 0 & $\dfrac{1}{K}$ \\[2ex]
\bottomrule
\end{tabular}
\end{table}

