\section*{Further Reading}

\begin{itemize}
    \item R.~E.~Kalman, ``Contributions to the Theory of Optimal Control,'' \textit{Bol. Soc. Mat. Mexicana}, vol.~5, pp.~102--119, 1960.

    \item L.~S.~Pontryagin, V.~G.~Boltyanskii, R.~V.~Gamkrelidze, and E.~F.~Mishchenko, \textit{The Mathematical Theory of Optimal Processes}, Interscience Publishers, 1962.

    \item R.~Bellman, \textit{Dynamic Programming}, Princeton University Press, 1957.

    \item B.~D.~O.~Anderson and J.~B.~Moore, \textit{Optimal Control: Linear Quadratic Methods}, Prentice-Hall, 1990.

    \item A.~E.~Bryson and Y.-C.~Ho, \textit{Applied Optimal Control}, Hemisphere Publishing, 1975.

