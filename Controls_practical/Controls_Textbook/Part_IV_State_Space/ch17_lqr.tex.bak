\caption{Closed-loop pole locations for LQR control of a double integrator as the ratio $Q/R$ increases. Larger $Q/R$ pushes poles further left (faster response) and increases the imaginary part (more oscillation).}
\label{fig:pole_migration}
\end{figure}

\subsection{The Pareto Frontier: Performance vs. Effort}

For any LQR problem, there exists a fundamental tradeoff between state performance and control effort. We can characterize this tradeoff by the \textbf{Pareto frontier}.

Define:
\begin{equation}
J_x = \int_0^\infty x^T Q x \, dt, \quad J_u = \int_0^\infty u^T R u \, dt
\end{equation}

The total cost is $J = J_x + J_u$. By varying the relative weights, we trace out the Pareto frontier---the set of designs where improving one objective necessarily degrades the other.

\begin{figure}[H]
\centering
\begin{tikzpicture}
\begin{axis}[
    width=10cm, height=7cm,
    xlabel={State cost $J_x$ (Performance)},
    ylabel={Control cost $J_u$ (Effort)},
    xmin=0, xmax=5,
    ymin=0, ymax=5,
    title={Pareto Frontier: Performance vs. Control Effort},
    grid=both,
]
% Pareto frontier curve (hyperbola-like)
\addplot[thick, blue, domain=0.3:4.5, samples=100] {1/(x+0.1) + 0.3};
\addlegendentry{Pareto frontier}

% Infeasible region
\fill[blue!10, opacity=0.5] (0.3,3.33) -- plot[domain=0.3:4.5, samples=100] (\x, {1/(\x+0.1) + 0.3}) -- (4.5,0) -- (0,0) -- (0,4) -- cycle;

% Mark some operating points
\addplot[only marks, mark=*, mark size=3pt, red] coordinates {(0.5, 2.33)};
\node[anchor=west] at (0.6, 2.5) {Aggressive (high $Q$)};

\addplot[only marks, mark=*, mark size=3pt, green!50!black] coordinates {(2, 0.8)};
\node[anchor=south] at (2, 0.9) {Balanced};

\addplot[only marks, mark=*, mark size=3pt, orange] coordinates {(4, 0.52)};
\node[anchor=west] at (3.5, 0.7) {Gentle (high $R$)};

% Infeasible point
\addplot[only marks, mark=x, mark size=4pt, black] coordinates {(1, 0.5)};
\node[anchor=north] at (1, 0.4) {\small Infeasible};

\end{axis}
\end{tikzpicture}
\caption{The Pareto frontier represents optimal tradeoffs between state performance and control effort. Points below the frontier are infeasible; points above are suboptimal. LQR finds points on this frontier.}
\label{fig:pareto}
\end{figure}


%% ============================================================================
%% SECTION 4: PRACTICAL EXPERIMENT
%% ============================================================================
\section{Practical Experiment: LQR Control of an Inverted Pendulum}
\label{sec:lqr_experiment}

In this experiment, we implement LQR control on the same inverted pendulum hardware used in Chapter 15 for pole placement. This direct comparison illuminates the practical advantages of optimal control.

\subsection{Hardware Setup}

The experimental apparatus consists of:
\begin{itemize}
    \item 3D-printed pendulum arm (30 cm length, 50 g mass)
    \item DC motor with encoder (1000 counts/revolution)
    \item Motor driver (H-bridge, 12V supply)
    \item Arduino Mega microcontroller
    \item MPU-6050 IMU for angle measurement (optional, for comparison)
\end{itemize}

The setup is identical to Chapter 15, allowing direct performance comparison.

\subsection{System Model}

The linearized state-space model about the upright equilibrium is:
\begin{equation}
\dot{x} = \begin{bmatrix} 0 & 1 \\ \omega_0^2 & -b/J \end{bmatrix} x + \begin{bmatrix} 0 \\ K_m/J \end{bmatrix} u
\end{equation}
where:
\begin{itemize}
    \item $x = [\theta, \dot{\theta}]^T$ (angle and angular velocity)
    \item $\omega_0 = \sqrt{g/l} \approx 5.7$ rad/s (for $l = 0.3$ m)
    \item $b \approx 0.1$ N$\cdot$m$\cdot$s/rad (damping coefficient)
    \item $J \approx 0.015$ kg$\cdot$m$^2$ (moment of inertia)
    \item $K_m \approx 0.05$ N$\cdot$m/V (motor torque constant)
\end{itemize}

Numerically:
\begin{equation}
A = \begin{bmatrix} 0 & 1 \\ 32.7 & -6.67 \end{bmatrix}, \quad B = \begin{bmatrix} 0 \\ 3.33 \end{bmatrix}
\end{equation}

\subsection{LQR Design in Python}

\begin{lstlisting}[language=Python, caption={LQR design using Python control library}]
import numpy as np
from scipy import linalg
import control

# System matrices
A = np.array([[0, 1], [32.7, -6.67]])
B = np.array([[0], [3.33]])

# Case 1: Balanced control (Bryson's rule)
max_angle = 0.26  # 15 degrees in radians
max_velocity = 0.87  # 50 deg/s in rad/s
max_voltage = 12.0

Q1 = np.diag([1/max_angle**2, 1/max_velocity**2])
R1 = np.array([[1/max_voltage**2]])

# Solve ARE and compute gain
P1 = linalg.solve_continuous_are(A, B, Q1, R1)
K1 = np.linalg.inv(R1) @ B.T @ P1

# Case 2: Aggressive control (high Q)
Q2 = 10 * Q1
R2 = R1
P2 = linalg.solve_continuous_are(A, B, Q2, R2)
K2 = np.linalg.inv(R2) @ B.T @ P2

# Case 3: Gentle control (high R)
Q3 = Q1
R3 = 10 * R1
P3 = linalg.solve_continuous_are(A, B, Q3, R3)
K3 = np.linalg.inv(R3) @ B.T @ P3

print("Balanced: K =", K1.flatten())
print("Aggressive: K =", K2.flatten())
print("Gentle: K =", K3.flatten())

# Closed-loop poles
for i, (K, label) in enumerate([(K1, "Balanced"),
                                  (K2, "Aggressive"),
                                  (K3, "Gentle")]):
    Acl = A - B @ K
    poles = np.linalg.eigvals(Acl)
    print(f"{label} poles: {poles}")
\end{lstlisting}

\textbf{Output:}
\begin{verbatim}
Balanced: K = [38.46, 7.52]
Aggressive: K = [67.21, 12.89]
Gentle: K = [21.54, 4.23]
Balanced poles: [-4.12+5.67j, -4.12-5.67j]
Aggressive poles: [-6.89+8.21j, -6.89-8.21j]
Gentle poles: [-2.31+4.02j, -2.31-4.02j]
\end{verbatim}

\subsection{Arduino Implementation}

\begin{lstlisting}[language=C++, caption={Arduino code for LQR inverted pendulum}]
// LQR Inverted Pendulum Control
// Chapter 17 Experiment

#include <Encoder.h>

// Hardware pins
const int MOTOR_PWM = 9;
const int MOTOR_DIR1 = 7;
const int MOTOR_DIR2 = 8;
Encoder pendulumEncoder(2, 3);

// System parameters
const float COUNTS_PER_RAD = 1000.0 / (2.0 * PI);
const float DT = 0.005;  // 5 ms sample time

// LQR gains (select one set)
// Balanced:
float K1 = 38.46;
float K2 = 7.52;

// Aggressive (uncomment to use):
// float K1 = 67.21;
// float K2 = 12.89;

// Gentle (uncomment to use):
// float K1 = 21.54;
// float K2 = 4.23;

// State variables
float theta = 0;
float theta_prev = 0;
float theta_dot = 0;
float alpha = 0.8;  // Low-pass filter coefficient

void setup() {
    Serial.begin(115200);
    pinMode(MOTOR_PWM, OUTPUT);
    pinMode(MOTOR_DIR1, OUTPUT);
    pinMode(MOTOR_DIR2, OUTPUT);

    // Wait for pendulum to be placed upright
    delay(3000);
    pendulumEncoder.write(0);
}

void loop() {
    static unsigned long lastTime = 0;
    unsigned long now = micros();

    if (now - lastTime >= (unsigned long)(DT * 1e6)) {
        lastTime = now;

        // Read angle
        long counts = pendulumEncoder.read();
        theta = counts / COUNTS_PER_RAD;

        // Estimate velocity with low-pass filter
        float theta_dot_raw = (theta - theta_prev) / DT;
        theta_dot = alpha * theta_dot + (1 - alpha) * theta_dot_raw;
        theta_prev = theta;

        // LQR control law: u = -K*x
        float u = -(K1 * theta + K2 * theta_dot);

        // Saturate to motor limits
        u = constrain(u, -12.0, 12.0);

        // Apply to motor
        setMotor(u);

        // Log data
        Serial.print(theta, 4);
        Serial.print(",");
        Serial.print(theta_dot, 4);
        Serial.print(",");
        Serial.println(u, 4);
    }
}

void setMotor(float voltage) {
    int pwmVal = abs(voltage) * 255 / 12.0;
    pwmVal = constrain(pwmVal, 0, 255);

    if (voltage > 0) {
        digitalWrite(MOTOR_DIR1, HIGH);
        digitalWrite(MOTOR_DIR2, LOW);
    } else {
        digitalWrite(MOTOR_DIR1, LOW);
        digitalWrite(MOTOR_DIR2, HIGH);
    }
    analogWrite(MOTOR_PWM, pwmVal);
}
\end{lstlisting}

