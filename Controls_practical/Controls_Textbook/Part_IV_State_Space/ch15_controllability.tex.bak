    \node at (0,0.5) {Cart};

    % Wheels
    \draw[fill=gray] (-0.5,0.2) circle (0.12);
    \draw[fill=gray] (0.5,0.2) circle (0.12);

    % Pivot point
    \fill (0,0.8) circle (0.08);

    % Pendulum
    \draw[thick] (0,0.8) -- (1.2,2.8);
    \draw[fill=red!50] (1.2,2.8) circle (0.2);
    \node at (1.5,2.8) {$m$};

    % Angle theta
    \draw[dashed] (0,0.8) -- (0,2.5);
    \draw[->] (0,1.8) arc (90:63:1);
    \node at (0.4,1.9) {$\theta$};

    % Force F
    \draw[->,thick,blue] (-1.5,0.5) -- (-0.9,0.5);
    \node[blue] at (-1.7,0.5) {$F$};

    % Position x
    \draw[<->] (0,-0.5) -- (1.5,-0.5);
    \node at (0.75,-0.8) {$x$};

    % Dimensions
    \draw[<->,gray] (0.1,0.8) -- (1.1,2.6);
    \node[gray] at (0.9,1.6) {$\ell$};

    % Gravity
    \draw[->,thick] (1.2,2.5) -- (1.2,2.0);
    \node at (1.5,2.2) {$mg$};
\end{tikzpicture}
\caption{Inverted pendulum on a cart. The cart of mass $M$ moves along a track, driven by force $F$. A pendulum of length $\ell$ and point mass $m$ is pivoted on the cart. The angle $\theta$ is measured from vertical.}
\label{fig:pendulum_fbd}
\end{figure}

\subsubsection{Equations of Motion}

Using Lagrangian mechanics, the equations of motion are:
\begin{align}
(M + m)\ddot{x} + m\ell\ddot{\theta}\cos\theta - m\ell\dot{\theta}^2\sin\theta &= F \\
m\ell^2\ddot{\theta} + m\ell\ddot{x}\cos\theta - mg\ell\sin\theta &= 0
\end{align}

Linearizing about the upright position ($\theta = 0$, $\dot{\theta} = 0$):
\begin{align}
(M + m)\ddot{x} + m\ell\ddot{\theta} &= F \\
m\ell\ddot{\theta} + m\ddot{x} - mg\theta &= 0
\end{align}

Defining state vector $\bx = \begin{bmatrix} x & \dot{x} & \theta & \dot{\theta} \end{bmatrix}^\top$ and input $u = F$:

\begin{equation}
\bA = \begin{bmatrix}
0 & 1 & 0 & 0 \\
0 & 0 & -\frac{mg}{M} & 0 \\
0 & 0 & 0 & 1 \\
0 & 0 & \frac{(M+m)g}{M\ell} & 0
\end{bmatrix}, \quad
\bB = \begin{bmatrix}
0 \\
\frac{1}{M} \\
0 \\
-\frac{1}{M\ell}
\end{bmatrix}
\label{eq:pendulum_ss}
\end{equation}

\subsubsection{Controllability Verification}

With typical parameters ($M = 0.5$ kg, $m = 0.2$ kg, $\ell = 0.3$ m, $g = 9.81$ m/s$^2$):

\begin{equation}
\mathcal{C} = \begin{bmatrix} \bB & \bA\bB & \bA^2\bB & \bA^3\bB \end{bmatrix}
\end{equation}

Computing:
\begin{equation}
\mathcal{C} = \begin{bmatrix}
0 & 2 & 0 & -26.16 \\
2 & 0 & -7.85 & 0 \\
0 & -6.67 & 0 & 130.8 \\
-6.67 & 0 & 45.71 & 0
\end{bmatrix}
\end{equation}

The determinant $\det(\mathcal{C}) \neq 0$, confirming $\rank(\mathcal{C}) = 4$. The system is controllable.

\subsection{Hardware Implementation}

\subsubsection{Components}

\begin{itemize}
\item \textbf{Cart}: 3D printed PLA, mounted on linear bearings
\item \textbf{Track}: 500mm aluminum extrusion with linear rail
\item \textbf{Motor}: NEMA 17 stepper or DC gear motor with encoder
\item \textbf{Drive}: Belt or lead screw for cart positioning
\item \textbf{Pendulum}: 300mm aluminum or carbon fiber rod
\item \textbf{Sensors}: Rotary encoder at pivot (1000+ PPR), motor encoder for position
\item \textbf{Controller}: Arduino Mega or Teensy 4.0
\item \textbf{Motor driver}: L298N or TB6612FNG
\end{itemize}

\subsubsection{3D Printing Specifications}

\begin{itemize}
\item Cart body: 100\% infill for rigidity
\item Bearing mounts: Tight tolerances ($\pm$0.1mm)
\item Pivot housing: Precision fit for encoder shaft
\item Material: PLA or PETG (ABS for higher temperature environments)
\end{itemize}

\subsection{Controller Implementation}

\begin{lstlisting}[style=arduino, caption={Arduino state feedback controller for inverted pendulum}]
// Inverted Pendulum State Feedback Controller
// Implements: u = -K1*x - K2*x_dot - K3*theta - K4*theta_dot

// State feedback gains (computed via pole placement)
const float K1 = -31.62;   // Position gain
const float K2 = -25.89;   // Velocity gain
const float K3 = 78.46;    // Angle gain
const float K4 = 14.52;    // Angular velocity gain

// Physical parameters
const float ENCODER_TO_RAD = 2.0 * PI / 4000.0;  // 1000 PPR * 4x
const float ENCODER_TO_M = 0.001;                 // mm per count

// State variables
volatile long cart_encoder = 0;
volatile long pend_encoder = 0;
float x = 0, x_dot = 0;
float theta = 0, theta_dot = 0;
float x_prev = 0, theta_prev = 0;

// Timing
unsigned long last_time = 0;
const float dt = 0.005;  // 5ms control loop (200 Hz)

void setup() {
  Serial.begin(115200);
  setupEncoders();
  setupMotor();

  // Wait for pendulum to be placed upright
  Serial.println("Place pendulum upright and press button");
  waitForStart();

  // Zero encoders at upright position
  cart_encoder = 0;
  pend_encoder = 0;

  last_time = micros();
}

void loop() {
  // Fixed-rate control loop
  if (micros() - last_time >= dt * 1e6) {
    last_time = micros();

    // Read and convert encoder values
    noInterrupts();
    x = cart_encoder * ENCODER_TO_M;
    theta = pend_encoder * ENCODER_TO_RAD;
    interrupts();

    // Compute velocities (filtered derivative)
    x_dot = 0.8 * x_dot + 0.2 * (x - x_prev) / dt;
    theta_dot = 0.8 * theta_dot + 0.2 * (theta - theta_prev) / dt;
    x_prev = x;
    theta_prev = theta;

    // State feedback control law
    float u = -K1*x - K2*x_dot - K3*theta - K4*theta_dot;

    // Saturate control signal
    u = constrain(u, -12.0, 12.0);

    // Apply control (if pendulum near upright)
    if (abs(theta) < 0.5) {  // ~30 degrees
      setMotorVoltage(u);
    } else {
      setMotorVoltage(0);  // Disable if fallen
      Serial.println("Pendulum fallen - reset required");
    }

    // Data logging
    Serial.print(x, 4); Serial.print(",");
    Serial.print(theta, 4); Serial.print(",");
    Serial.println(u, 4);
  }
}

void setupEncoders() {
  // Configure encoder interrupt pins
  pinMode(2, INPUT_PULLUP);  // Cart encoder A
  pinMode(3, INPUT_PULLUP);  // Cart encoder B
  pinMode(18, INPUT_PULLUP); // Pendulum encoder A
  pinMode(19, INPUT_PULLUP); // Pendulum encoder B

  attachInterrupt(digitalPinToInterrupt(2), cartEncoderISR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(18), pendEncoderISR, CHANGE);
}

void cartEncoderISR() {
  // Quadrature decoding
  if (digitalRead(2) == digitalRead(3)) {
    cart_encoder++;
  } else {
    cart_encoder--;
  }
}

void pendEncoderISR() {
  if (digitalRead(18) == digitalRead(19)) {
    pend_encoder++;
  } else {
    pend_encoder--;
  }
}
\end{lstlisting}

