    % S-plane
    \begin{scope}[xshift=-3cm]
        \draw[->] (-2,0) -- (1,0) node[right] {$\sigma$};
        \draw[->] (0,-1.8) -- (0,1.8) node[above] {$j\omega$};
        \fill[blue] (-1.5,0) circle (2pt) node[below] {$s_1$};
        \fill[blue] (-0.5,1) circle (2pt) node[above right] {$s_2$};
        \fill[blue] (-0.5,-1) circle (2pt) node[below right] {$s_3$};
