\textbf{Key Properties of the Mapping:}

\begin{enumerate}
    \item \textbf{Left Half-Plane $\to$ Inside Unit Circle:} For $s = \sigma + j\omega$ with $\sigma < 0$:
    \begin{equation}
    |z| = |e^{sT}| = e^{\sigma T} < 1
    \end{equation}

    \item \textbf{Imaginary Axis $\to$ Unit Circle:} For $s = j\omega$:
    \begin{equation}
    |z| = |e^{j\omega T}| = 1
    \end{equation}

    \item \textbf{Right Half-Plane $\to$ Outside Unit Circle:} For $\sigma > 0$:
    \begin{equation}
    |z| = e^{\sigma T} > 1
    \end{equation}

    \item \textbf{Periodicity:} The mapping is periodic in $\omega$ with period $\omega_s = 2\pi/T$:
    \begin{equation}
    e^{s_1 T} = e^{s_2 T} \quad \text{if} \quad s_2 = s_1 + jk\omega_s, \quad k \in \mathbb{Z}
    \end{equation}
    This reflects the aliasing phenomenon: frequencies differing by multiples of the sampling frequency map to the same point in the z-plane.
\end{enumerate}

\subsection{Discrete Stability Criterion}

\begin{theorem}[Discrete-Time Stability]
A discrete-time LTI system with transfer function $H(z)$ is BIBO (bounded-input bounded-output) stable if and only if all poles of $H(z)$ lie strictly inside the unit circle:
\begin{equation}
|p_i| < 1 \quad \text{for all poles } p_i
\end{equation}
\end{theorem}

\begin{proof}
The impulse response of the system is $h[n] = \ztrans^{-1}\{H(z)\}$. For a pole at $z = p$ with $|p| < 1$, the corresponding impulse response term is proportional to $p^n$, which decays geometrically to zero. The system is BIBO stable if $\sum_{n=0}^{\infty} |h[n]| < \infty$, which requires all terms to decay, hence all poles must satisfy $|p| < 1$.
\end{proof}

\begin{figure}[H]
\centering
\begin{tikzpicture}[scale=1.0]
    % Z-plane with unit circle
    \begin{scope}[xshift=-5cm]
        \draw[->] (-2.5,0) -- (2.5,0) node[right] {$\real(z)$};
        \draw[->] (0,-2.5) -- (0,2.5) node[above] {$\imag(z)$};
        \draw[thick,dashed] (0,0) circle (2);
        \node at (2.2,-0.3) {$1$};

        % Stable poles inside
        \fill[blue] (0.8,0.6) circle (3pt);
        \fill[blue] (0.8,-0.6) circle (3pt);
        \fill[blue] (-0.5,0) circle (3pt);
        \node[blue] at (0,-1.5) {Stable poles};
        \node at (0,-3) {\textbf{(a) Stable System}};
    \end{scope}

    % Time response - stable
