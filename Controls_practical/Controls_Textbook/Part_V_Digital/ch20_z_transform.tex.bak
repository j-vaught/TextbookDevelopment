        \draw[->] (-1.5,0) -- (1.5,0) node[right] {$\real$};
        \draw[->] (0,-1.5) -- (0,1.5) node[above] {$\imag$};
        \draw[dashed] (0,0) circle (1);
        \fill[blue] (0.549,0) circle (2pt) node[below right] {$z_1$};
        \fill[blue] (0.755,0.319) circle (2pt) node[above right] {$z_2$};
        \fill[blue] (0.755,-0.319) circle (2pt) node[below right] {$z_3$};
