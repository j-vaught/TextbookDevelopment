        \draw[->] (-0.5,0) -- (4,0) node[right] {$n$};
        \draw[->] (0,-1) -- (0,2.5) node[above] {$y[n]$};

        % Decaying response
        \foreach \n in {0,1,...,15} {
            \fill[blue] (0.22*\n, {1.5*exp(-0.2*\n)*cos(60*\n)}) circle (1.5pt);
        }
        \draw[blue,dashed,domain=0:3.5,samples=50] plot (\x, {1.5*exp(-0.6*\x)});
        \draw[blue,dashed,domain=0:3.5,samples=50] plot (\x, {-1.5*exp(-0.6*\x)});
        \node at (1.8,-2) {Decaying oscillation};
    \end{scope}

    % Z-plane with poles outside
